# Database (SQLite file by default — swap for Postgres/MySQL URL in production)
DATABASE_URL="file:./dev.db"

# Admin dashboard (Basic Auth) — change these before deploying
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me-now"

# Outbound email notification for new leads (SMTP). If left blank, submissions
# are only stored in the database and logged to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
LEAD_NOTIFICATION_EMAIL="you@example.com"
LEAD_FROM_EMAIL="leads@buildyouridea.com"

# Analytics — public, exposed to the browser
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
