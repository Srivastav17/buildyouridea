generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// SQLite has no native enum support, so lead status is stored as a plain
// string constrained at the application layer (see lib/leadOptions.ts).
model Lead {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Form fields
  idea        String
  audience    String
  stage       String
  goal        String
  budget      String
  name        String
  email       String
  phone       String

  // Pipeline
  status      String     @default("NEW")
  notes       String?

  // Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?
  landingPage String?
  userAgent   String?

  @@index([status])
  @@index([createdAt])
}

// A single website chat widget conversation. Contact details are required
// before the visitor can send their first real message (see app/api/chat).
model ChatSession {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  name            String?
  email           String
  phone           String

  // Array of { role: "user" | "assistant", content: string, ts: string }
  messages        Json

  turnCount       Int       @default(0)
  rootMessageId   String?

  @@index([createdAt])
}
